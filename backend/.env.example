# Local development configuration. Copy values into your shell environment before starting Spring.
DB_URL=jdbc:mysql://localhost:3306/pawly_db
DB_USERNAME=pawly_app
DB_PASSWORD=replace-with-local-database-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_EXPIRATION_MS=86400000
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
REGISTER_RATE_LIMIT_MAX=5
REGISTER_RATE_LIMIT_WINDOW_SECONDS=3600
DDL_AUTO=update
